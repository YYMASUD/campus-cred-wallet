pragma solidity ^0.8.24;

import {AccessControl} from "@openzeppelin/contracts/access/AccessControl.sol";

/**
 * @title ZKVerifier
 * @notice Routes Groth16 proofs to the per-circuit verifier contracts.
 * @dev The actual verifier contracts (Groth16Verifier) are generated by snarkjs
 *      from the Circom circuits in packages/zk-circuits. This registry holds the
 *      trusted verifier address per circuitId and enforces replay protection by
 *      tracking consumed proof commitments.
 */
contract ZKVerifier is AccessControl {
    bytes32 public constant GOVERNANCE_ROLE = keccak256("GOVERNANCE_ROLE");

    enum CircuitId {
        AgeOver,
        Membership,
        NonRevocation,
        AttributeEquals
    }

    /// @dev circuit id => groth16 verifier address
    mapping(uint8 => address) public verifierFor;
    /// @dev proof commitment => consumed (replay protection)
    mapping(bytes32 => bool) public consumed;

    event VerifierSet(uint8 indexed circuitId, address verifier);
    event ProofAccepted(uint8 indexed circuitId, bytes32 commitment);

    error NoVerifier(uint8 circuitId);
    error ProofReplayed(bytes32 commitment);
    error ZeroAddress();

    constructor(address admin) {
        if (admin == address(0)) revert ZeroAddress();
        _grantRole(DEFAULT_ADMIN_ROLE, admin);
        _grantRole(GOVERNANCE_ROLE, admin);
    }

    function setVerifier(uint8 circuitId, address verifier) external onlyRole(GOVERNANCE_ROLE) {
        if (verifier == address(0)) revert ZeroAddress();
        verifierFor[circuitId] = verifier;
        emit VerifierSet(circuitId, verifier);
    }

    /**
     * @notice Verify a Groth16 proof through the registered verifier.
     * @param circuitId circuit selector
     * @param a G1 point A
     * @param b G2 point B
     * @param c G1 point C
     * @param publicSignals circuit public inputs
     */
    function verify(
        uint8 circuitId,
        uint256[2] calldata a,
        uint256[2][2] calldata b,
        uint256[2] calldata c,
        uint256[] calldata publicSignals
    ) external returns (bool) {
        address v = verifierFor[circuitId];
        if (v == address(0)) revert NoVerifier(circuitId);

        bytes32 commitment = keccak256(abi.encode(circuitId, a, b, c, publicSignals));
        if (consumed[commitment]) revert ProofReplayed(commitment);

        (bool ok, bytes memory ret) =
            v.call(abi.encodeWithSignature("verifyProof(uint256[2],uint256[2][2],uint256[2],uint256[])", a, b, c, publicSignals));
        require(ok, "verifier reverted");
        bool valid = abi.decode(ret, (bool));
        require(valid, "invalid proof");

        consumed[commitment] = true;
        emit ProofAccepted(circuitId, commitment);
        return true;
    }

    /// @notice View-only check (does not consume).
    function verifyView(
        uint8 circuitId,
        uint256[2] calldata a,
        uint256[2][2] calldata b,
        uint256[2] calldata c,
        uint256[] calldata publicSignals
    ) external view returns (bool) {
        address v = verifierFor[circuitId];
        if (v == address(0)) revert NoVerifier(circuitId);
        (bool ok, bytes memory ret) = v.staticcall(
            abi.encodeWithSignature("verifyProof(uint256[2],uint256[2][2],uint256[2],uint256[])", a, b, c, publicSignals)
        );
        if (!ok) return false;
        return abi.decode(ret, (bool));
    }
}
