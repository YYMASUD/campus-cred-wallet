# ===== campus-cred-wallet example env =====
# Copy to .env and fill in. NEVER commit a real .env.

# Chain
CHAIN_ID=31337
RPC_URL=http://localhost:8545
# Testnet (Sepolia / Polygon Amoy) - fill for deployment only
TESTNET_RPC_URL=
DEPLOYER_PRIVATE_KEY=

# Issuer API
ISSUER_API_PORT=3001
ISSUER_API_DATABASE_URL=postgres://postgres:postgres@localhost:5432/issuer
ISSUER_DID=did:web:issuer.example.edu
ISSUER_SIGNING_KEY=

# Verifier API
VERIFIER_API_PORT=3002
VERIFIER_API_DATABASE_URL=postgres://postgres:postgres@localhost:5432/verifier
VERIFIER_DOMAIN=verifier.example.edu

# Indexer
INDEXER_PORT=3003

# Shared infra
REDIS_URL=redis://localhost:6379
IPFS_API_URL=http://localhost:5001
IPFS_GATEWAY_URL=http://localhost:8080

# Web apps
VITE_WALLET_API_URL=http://localhost:3001
VITE_VERIFIER_API_URL=http://localhost:3002
